# ---- Required in production ----
# Random 32+ char string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app (used in emails and share links)
BETTER_AUTH_URL=http://localhost:3000

# ---- Database ----
# Postgres connection string (Neon, Supabase, Railway, local…).
# Leave empty to use the embedded database in ./.data/pglite (great for trying it out).
DATABASE_URL=

# ---- Email (optional) ----
# Without a key, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Approval OS <approvals@yourdomain.com>"

# ---- Google sign-in (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- File storage (optional) ----
# Any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO). Empty = ./.data/uploads on disk.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Misc ----
# Protects /api/cron/reminders (due-date reminder emails). Vercel Cron sends it automatically.
CRON_SECRET=
MAX_UPLOAD_MB=20
# Set to false to skip running migrations on server start.
AUTO_MIGRATE=true
